# Copy this file to .env. Do not commit .env.
ASR_MODEL_PATH=models/ggml-large-v3-turbo.bin
ASR_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
ASR_LANGUAGE=auto
ASR_THREADS=8
ASR_WHISPER_BIN=whisper-cli
ASR_PROMPT=这是一段关于高尔夫的中文录音，可能夹杂英文。请准确识别高尔夫术语、球杆名称、球员姓名、品牌和英文缩写；保留原意，不要翻译，不要补写没有说出的内容。
